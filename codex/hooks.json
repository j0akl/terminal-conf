{
  "description": "Notify when Codex finishes a turn or needs approval.",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.codex/notify-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.codex/notify-hook.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
